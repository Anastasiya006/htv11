{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "gemmi-display",
            "type": "command",
            "command": "node \"$GEMINI_PROJECT_DIR/simulator/gemini-hook.cjs\"",
            "timeout": 1000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "gemmi-display",
            "type": "command",
            "command": "node \"$GEMINI_PROJECT_DIR/simulator/gemini-hook.cjs\"",
            "timeout": 1000
          }
        ]
      }
    ],
